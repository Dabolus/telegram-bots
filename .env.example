# The name of your service on Serverless
SERVICE_NAME="my-service"
# Whether to enable analytics collection or not
ENABLE_ANALYTICS="true"
ANALYTICS_API_SECRET="abcdefghijklmnopqrstuv"
ANALYTICS_MEASUREMENT_ID="G-0123456789"
# The secret token used to make sure the call to the webhooks comes from Telegram
SECRET_TOKEN="e48a3d3b-fc89-40c2-8a04-11502f286035"
# The variables needed by Google Custom Search API
GOOGLE_CUSTOM_SEARCH_API_KEY="ABCDEFGHIJKLMNOPQRSTUVWXYZABCDEFGHIJKLM"
GOOGLE_CUSTOM_SEARCH_CX="123456789012345678901:abcdefghijk"
# The variables needed by OpenAI API
OPENAI_API_KEY="sk-ABCDEFGHIJKLMNOPQRSTUVWXYZABCDEFGHIJKLMN"
# The variables needed by Anthropic API
ANTHROPIC_API_KEY="sk-ant-api00-abcd-abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
# The tokens for each of the available bots
DABBEXT_BOT_TOKEN="123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi"
QUOTE_GENERATOR_BOT_TOKEN="123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi"
TELEGRAM_MEDIA_CONVERT_BOT_TOKEN="123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi"
WOTD_BOT_TOKEN="123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi"
CHATTGB_BOT_TOKEN="123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi"
# The list of chat IDs allowed to receive the word of the day
WOTD_CHAT_IDS_ALLOWLIST="0123456789"
# The list of chat IDs allowed to use ChatTGB
CHATTGB_CHAT_IDS_ALLOWLIST="0123456789"
# The IDs of the users allowed to use admin commands on ChatTGB
CHATTGB_ADMIN_USER_IDS="0123456789"
# The Unsplash access key for Quote Generator
QUOTE_GENERATOR_UNSPLASH_ACCESS_KEY="ABCDEFGHIJKLMNOPQRSTUVWXYZABCDEFGHIJKLMNOPQ"
# Google Cloud related variables
GCLOUD_LOCATION="gcloud-region1"
GCLOUD_PROJECT_ID="gcloud-project-id"

# Secrets only needed by the CI/CD pipeline
# Base64 encoded JSON service account for Quote Generator
QUOTE_GENERATOR_SERVICE_ACCOUNT_BASE64="abcdef123=="
# Base64 encoded JSON service account for ChatTGB
CHATTGB_SERVICE_ACCOUNT_BASE64="abcdef123=="
# Base64 encoded JSON service account for Video Meet
VIDEO_MEET_SERVICE_ACCOUNT_BASE64="abcdef123=="
# The access key needed for serverless deployment
SERVERLESS_ACCESS_KEY="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRS"
